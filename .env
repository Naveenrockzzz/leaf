# ==============================================
# LEAF-2 E-COMMERCE - ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ----------------------------------------------
# Backend API Configuration
# ----------------------------------------------
# Your Strapi backend URL (without trailing slash)
VITE_API_BASE_URL=http://51.68.190.162:1337/api

# Base URL for serving images
VITE_Image_BASE_URL=http://51.68.190.162:1337

# ----------------------------------------------
# Payment Configuration
# ----------------------------------------------
# Get your Stripe keys from: https://dashboard.stripe.com/apikeys
# Use test keys for development, live keys for production
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_TEST_KEY_HERE

# ----------------------------------------------
# Third-Party Services
# ----------------------------------------------
# RapidShyp API Token for shipping calculations
# Get from: https://www.rapidshyp.com/
# ⚠️ WARNING: Move this to backend for security!
VITE_RAPIDSHYP_TOKEN=your_rapidshyp_token_here

# ----------------------------------------------
# Backend Services (Node.js Express)
# ----------------------------------------------
# OTP Service URL (currently running on localhost:5000)
VITE_OTP_SERVICE_URL=http://localhost:5000

# Payment Intent Service URL (currently running on localhost:5000)
VITE_PAYMENT_SERVICE_URL=http://localhost:5000

# ----------------------------------------------
# WhatsApp Business API
# ----------------------------------------------
# WhatsApp business phone number (format: country code + number)
VITE_WHATSAPP_PHONE=918285684222

# ----------------------------------------------
# Feature Flags (Optional)
# ----------------------------------------------
# Enable/disable features during development
VITE_ENABLE_REVIEWS=true
VITE_ENABLE_WISHLIST=true
VITE_ENABLE_CART_PERSISTENCE=true

# ----------------------------------------------
# Environment
# ----------------------------------------------
VITE_ENV=development
# Options: development | staging | production

# ----------------------------------------------
# Notes:
# ----------------------------------------------
# 1. All variables starting with VITE_ are accessible in the frontend
# 2. Never expose sensitive backend keys in frontend code
# 3. For production, use proper secret management (AWS Secrets Manager, etc.)
# 4. Rotate all API keys before going to production
# 5. Add .env to .gitignore

